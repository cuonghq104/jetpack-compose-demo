<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.JetpackComposeDemo" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="Theme.JetpackComposeDemo.AppCompat" parent="Theme.MaterialComponents.Light.NoActionBar" />

    <!-- Skeleton placeholder styles for the shimmer date picker -->
    <style name="SkeletonWeekday">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">10dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginHorizontal">6dp</item>
        <item name="android:background">@drawable/bg_skeleton_rounded</item>
    </style>

    <style name="SkeletonRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:layout_marginTop">4dp</item>
    </style>

    <style name="SkeletonCell">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginHorizontal">4dp</item>
        <item name="android:background">@drawable/bg_skeleton_rounded</item>
    </style>

    <style name="WeekdayHeader">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#888888</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>